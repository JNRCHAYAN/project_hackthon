# Copy to .env and fill in only if you want LLM-generated phrasing.
#
# If this is unset the application still works: alerts fall back to the
# deterministic Bengali/English template assembler, which produces a complete
# alert including situation, evidence, uncertainty and next steps. Only the
# phrasing is less natural.
#
# NEVER commit a real token. In deployment, set it in the host's dashboard.
ANTHROPIC_AUTH_TOKEN=
